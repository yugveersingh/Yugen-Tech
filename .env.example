# Public site URL, used for canonical URLs, Open Graph and the sitemap.
# Optional. Defaults to https://dronzerr.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://dronzerr.vercel.app

# No other variables are used by this website.
# Never put broker, database or API secrets in NEXT_PUBLIC_* variables:
# anything with that prefix is shipped to the browser.
